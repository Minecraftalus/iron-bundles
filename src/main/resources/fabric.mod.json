{
	"schemaVersion": 1,
	"id": "iron-bundles",
	"version": "${version}",
	"name": "Iron Bundles",
	"description": "6 new tiers of bundles for better inventory management",
	"authors": [
		"Minecraftalus"
	],
	"contact": {
		"homepage": "https://github.com/Minecraftalus",
		"sources": "https://github.com/Minecraftalus/iron-bundles"
	},
	"license": "MIT",
	"icon": "assets/iron-bundles/icon.png",
	"environment": "*",
    "accessWidener": "iron-bundles.accesswidener",
    "entrypoints": {
		"main": [
            "io.github.minecraftalus.ironbundles.IronBundles"
		],
		"client": [
            "io.github.minecraftalus.ironbundles.client.IronBundlesClient"
		],
		"fabric-datagen": [
            "io.github.minecraftalus.ironbundles.data.IronBundlesDataGenerator"
		]
	},
	"mixins": [
		"iron-bundles.mixins.json",
		{
			"config": "iron-bundles.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.2",
		"java": ">=21",
		"fabric-api": "*"
	}
}
